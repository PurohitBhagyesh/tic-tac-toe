# Backend Environment Variables
PORT=5000

# PostgreSQL Connection String (e.g. Supabase, Neon, or local postgres://user:password@localhost:5432/tictactoe)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-SUPABASE-PROJECT].supabase.co:5432/postgres

# Allowed Client Origin (Development or Production Vercel URL)
CLIENT_URL=http://localhost:5173
